<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://sun.com">
<properties>

    <entry key="database.driver">org.postgresql.Driver</entry>
    <entry key="database.url">${DATABASE_URL}</entry>
    <entry key="database.user">${DATABASE_USER}</entry>
    <entry key="database.password">${DATABASE_PASSWORD}</entry>

    <entry key="web.port">8082</entry>
    <entry key="web.address">0.0.0.0</entry>

    <entry key="logger.console">true</entry>

</properties>
